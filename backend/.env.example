# Servidor
PORT=3000
NODE_ENV=production

# Banco PostgreSQL
DATABASE_URL=postgres://rota_user:senha_segura@localhost:5432/rotatravada

# JWT
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES=12h

# Chave que o SISTEMA DE ROTEIRIZAÇÃO externo usa para postar rotas no webhook
ROUTE_INGEST_API_KEY=chave-do-webhook-troque-tambem

# Tolerância padrão de desvio em metros (Admin pode sobrescrever por frota)
DEFAULT_DEVIATION_TOLERANCE_M=150
